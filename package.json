{
  "name": "tayibat-life",
  "version": "1.0.6",
  "private": true,
  "description": "Tayibat Life PWA and Capacitor Android wrapper.",
  "scripts": {
    "serve": "python -m http.server 5173",
    "validate": "node --check app.js && node --check sw.js && node scripts/validate-deploy.js",
    "check:netlify-json": "node scripts/check-netlify-json.js",
    "netlify:link": "netlify link",
    "deploy:netlify": "netlify deploy --dir .",
    "deploy:netlify:prod": "netlify deploy --prod --dir .",
    "prepare:cap": "node scripts/prepare-capacitor-web-assets.js",
    "cap:init": "npx cap init TayibatLife com.tayibat.life --web-dir www",
    "cap:add:android": "npx cap add android",
    "precap:sync": "npm run prepare:cap",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "latest",
    "@capacitor/core": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "latest",
    "netlify-cli": "latest"
  }
}
